# Copy this file to .env and fill in your own values.
# Never commit your actual .env file.

# Required for AI features (natural-language task creation, topic
# breakdown, and the "ask about your plan" assistant). Without this,
# the rest of the app still works normally.
ANTHROPIC_API_KEY=

# Optional: override which Claude model is used for AI features.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: change the local port the app runs on.
PORT=5000

# Optional: set to 0 to disable Flask's debug/auto-reload mode.
FLASK_DEBUG=1
